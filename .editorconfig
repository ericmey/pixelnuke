# EditorConfig - https://editorconfig.org
# Pixelnuke project settings

root = true

# Default for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C/C++ - Circle framework uses 8-space tabs
[*.{c,cpp,h,hpp,cc,hh}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 100

# Makefiles require tabs
[Makefile]
indent_style = tab
indent_size = 8

[*.mk]
indent_style = tab
indent_size = 8

# Shell scripts
[*.sh]
indent_style = space
indent_size = 4

# YAML (GitHub Actions, etc.)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON
[*.json]
indent_style = space
indent_size = 2

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Config files
[*.{cfg,txt,conf}]
indent_style = space
indent_size = 4
